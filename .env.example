MYSQL_DATABASE=orp
MYSQL_USER=orp
MYSQL_PASSWORD=orp-local
MYSQL_ROOT_PASSWORD=orp-root
ORP_ADMIN_USERNAME=admin
# Set a unique password before starting the control plane.
ORP_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32. Back up this key with database backups.
ORP_DATA_KEY=
# One-time migration source. These values are never used by the running stack.
MIGRATION_SOURCE_DB_URL=jdbc:mysql://192.168.100.6:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MIGRATION_SOURCE_DB_USERNAME=orp
MIGRATION_SOURCE_DB_PASSWORD=
ORP_OIDC_ISSUER=http://localhost:8081/realms/orp
# Runtime options below are managed in 系统配置 by default. Set an environment
# variable only when you intentionally want it to override the database value.
# ORP_HTTP_ADDR=:8081
# ORP_AGENT_HTTPS_ADDR=:18443
# ORP_AGENT_TLS_CERT_FILE=/etc/orp/tls/server.crt
# ORP_AGENT_TLS_KEY_FILE=/etc/orp/tls/server.key
# ORP_AGENT_CLIENT_CA_FILE=/etc/orp/tls/client-ca.crt
# ORP_AGENT_PUBLIC_URL=https://agent.example.com:18443
# ORP_REDIS_ADDR=127.0.0.1:6379
# ORP_REDIS_PASSWORD=
# ORP_REDIS_DB=0
# ORP_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# ORP_KAFKA_TOPIC=orp-access-logs
# ORP_KAFKA_CONSUMER_GROUP=orp-control-plane-v1
# ORP_GEOIP_DB_PATH=/var/lib/orp/GeoLite2-City.mmdb
# ORP_GEOIP_STORAGE_DIR=runtime/geoip
# ORP_CAPTCHA_ENABLED=false
# Optional control-plane node IDs; Filebeat node names provide fallback mapping.
FILEBEAT_EAST_1_NODE_ID=
FILEBEAT_EAST_2_NODE_ID=
FILEBEAT_EAST_3_NODE_ID=
