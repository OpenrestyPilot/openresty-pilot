# Compose services
MYSQL_DATABASE=orp
MYSQL_USER=orp
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

# Go control plane
ORP_HTTP_ADDR=:8081
# Optional dedicated node-Agent mTLS listener. Leave all four blank to disable it.
ORP_AGENT_HTTPS_ADDR=
ORP_AGENT_TLS_CERT_FILE=
ORP_AGENT_TLS_KEY_FILE=
ORP_AGENT_CLIENT_CA_FILE=
# Public HTTPS URL reachable from managed OpenResty nodes, commonly :18443.
ORP_AGENT_PUBLIC_URL=
ORP_DB_URL=jdbc:mysql://127.0.0.1:3306/orp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
ORP_DB_USERNAME=orp
ORP_DB_PASSWORD=change-this-local-password
ORP_ADMIN_USERNAME=admin
ORP_ADMIN_PASSWORD=change-this-before-starting
# Generate with: openssl rand -hex 32. Keep stable and back it up with the database.
ORP_DATA_KEY=
ORP_REDIS_ADDR=127.0.0.1:6379
ORP_REDIS_PASSWORD=
ORP_REDIS_DB=0
ORP_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
ORP_KAFKA_TOPIC=orp-access-logs
ORP_KAFKA_CONSUMER_GROUP=orp-control-plane-v1
ORP_GEOIP_DB_PATH=
ORP_GEOIP_STORAGE_DIR=runtime/geoip
FILEBEAT_EAST_1_NODE_ID=
FILEBEAT_EAST_2_NODE_ID=
FILEBEAT_EAST_3_NODE_ID=

# Optional one-time external database migration source. Never used by runtime services.
MIGRATION_SOURCE_DB_URL=jdbc:mysql://db.example.invalid:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MIGRATION_SOURCE_DB_USERNAME=
MIGRATION_SOURCE_DB_PASSWORD=
